#!/bin/bash
# forced command of the CI deploy key: allows only "upload <sha>" and "deploy <sha> <sha256>"
set -euo pipefail

readonly INCOMING=/opt/phoenix/incoming
readonly MAX_BINARY_BYTES=$((64 << 20))
readonly SHA_RE='^[0-9a-f]{40}$'
readonly SUM_RE='^[0-9a-f]{64}$'

read -r -a cmd <<<"${SSH_ORIGINAL_COMMAND:-}"

case "${cmd[0]:-}" in
upload)
  [[ ${#cmd[@]} -eq 2 && ${cmd[1]} =~ $SHA_RE ]] || { echo "usage: upload <sha>" >&2; exit 2; }
  # only one pending upload at a time, so the disk can't be filled
  find "$INCOMING" -mindepth 1 -maxdepth 1 -exec rm -rf {} +
  install -d -m 700 "${INCOMING}/${cmd[1]}"
  head -c "$((MAX_BINARY_BYTES + 1))" >"${INCOMING}/${cmd[1]}/phoenix"
  if (($(stat -c %s "${INCOMING}/${cmd[1]}/phoenix") > MAX_BINARY_BYTES)); then
    rm -rf "${INCOMING:?}/${cmd[1]}"
    echo "binary is larger than ${MAX_BINARY_BYTES} bytes" >&2
    exit 2
  fi
  ;;
deploy)
  [[ ${#cmd[@]} -eq 3 && ${cmd[1]} =~ $SHA_RE && ${cmd[2]} =~ $SUM_RE ]] ||
    { echo "usage: deploy <sha> <sha256>" >&2; exit 2; }
  exec sudo /usr/local/bin/phoenix-deploy "${cmd[1]}" "${cmd[2]}"
  ;;
*)
  echo "command not allowed" >&2
  exit 2
  ;;
esac
